# Copy this file to `.env` and fill in real values for your environment.

# --- General -----------------------------------------------------------
ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB (posts, replies, notifications) -----------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sathi

# --- Postgres / Supabase (users, auth) -----------------------------------
# Local dev:
POSTGRES_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/sathi
# Supabase example (get this from Project Settings -> Database -> Connection string,
# then swap the scheme to postgresql+asyncpg):
# POSTGRES_URI=postgresql+asyncpg://postgres:<password>@<project-ref>.supabase.co:5432/postgres

# --- Auth ----------------------------------------------------------------
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Media -----------------------------------------------------------------
MAX_IMAGE_SIZE_BYTES=5242880

# --- ML: text classifier ---------------------------------------------------
# Point this at the checkpoint produced by the model-training repo
# (major-project-model-training/src/train.py -> ./models/muril_combined).
# Leave as-is / nonexistent to run on the heuristic fallback classifier.
TEXT_MODEL_PATH=./models/muril_combined
TEXT_MODEL_MAX_LENGTH=192
UNCERTAIN_CONFIDENCE_THRESHOLD=0.60

# --- ML: image encoder -------------------------------------------------
ENABLE_IMAGE_ENCODER=true
IMAGE_MODEL_NAME=WinKawaks/vit-tiny-patch16-224

# --- Real-time verification (future stage) --------------------------------
ENABLE_REALTIME_VERIFICATION=false

# --- Feed ------------------------------------------------------------------
DEFAULT_FEED_LIMIT=20
MAX_FEED_LIMIT=100
